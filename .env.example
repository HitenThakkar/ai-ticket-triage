# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value here is also the default in src/config.js,
# so the service runs with no .env at all as long as DATABASE_URL is set.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- HTTP -------------------------------------------------------------------
PORT=3000
# all | api | worker  (also settable with --role=...)
ROLE=all
# Comma-separated. Leave empty to disable API-key auth (handy for local poking).
API_KEYS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://triage:triage@localhost:5432/triage
PGPOOL_MAX=10

# --- Language model ---------------------------------------------------------
# fake   -> deterministic local stand-in. No API key, no network, no cost.
# gemini -> real Gemini call via the Interactions API (needs GEMINI_API_KEY).
#
# Leave this commented out and the service picks for you: gemini if a key is
# set below, fake if not. Uncomment to force one or the other.
# LLM_PROVIDER=fake

# Get a key at https://aistudio.google.com/apikey
# Note: a Gemini/Google AI Pro *subscription* is for the Gemini app and does not
# include API access - the API is billed separately and has its own free tier.
GEMINI_API_KEY=

# Gemini retires model IDs on a schedule, so this is configuration, not a constant.
# `npm run models` lists what your key can use right now.
#   gemini-3.5-flash-lite  fast + cheap, the right default for triage
#   gemini-3.8-flash       step up if you see misclassification
TRIAGE_MODEL=gemini-3.5-flash-lite

# Optional. Only sent when set - not every model accepts it, and an unsupported
# value is a 400 rather than a graceful ignore.
# Measured on gemini-3.5-flash-lite: leaving this unset gave a ~8.9s median per
# triage; `low` gave ~4.7s with identical categories and priorities. Worth turning
# on once you have re-measured on your own traffic.
# minimal | low | medium | high
# GEMINI_THINKING_LEVEL=low

TRIAGE_MAX_TOKENS=1024
LLM_TIMEOUT_MS=20000
# Ask the provider to constrain decoding to our JSON schema. We still validate:
# Gemini's schema support ignores minLength/maxLength.
LLM_STRUCTURED_OUTPUT=true

# Fake-provider failure injection (for demos and tests)
FAKE_LATENCY_MS=50
FAKE_FAILURE_RATE=0
FAKE_FAILURE_MODE=rate_limit

# --- Worker -----------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_BATCH_SIZE=5
WORKER_POLL_INTERVAL_MS=1000
# A ticket locked for longer than this is assumed to belong to a dead worker.
WORKER_STALE_LOCK_MS=120000
# Delivery attempts before a ticket is marked `failed`.
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_MS=5000
WORKER_BACKOFF_MAX_MS=300000
WORKER_SHUTDOWN_GRACE_MS=15000

# --- Triage -----------------------------------------------------------------
# Model calls per delivery attempt before a ticket goes to needs_review.
TRIAGE_VALIDATION_ATTEMPTS=3
TRIAGE_CACHE_ENABLED=true

# --- Duplicate detection (optional) -----------------------------------------
DUPLICATE_DETECTION_ENABLED=true
EMBEDDING_PROVIDER=hash
# Near-duplicates measure ~0.83+ with the local embedder; unrelated tickets ~0.2.
DUPLICATE_SIMILARITY_THRESHOLD=0.80
DUPLICATE_CANDIDATE_LIMIT=25
